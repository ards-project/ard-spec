; CDDL Specification for Agentic Resource Discovery (ARD entry, manifest & Registry schemas)
; Compliant with IETF RFC 8610 (Concise Data Definition Language)
;
; This file is a restatement of spec/schemas/ard-entry.schema.json and
; spec/schemas/ard-change.schema.json for CBOR/CDDL consumers. Where they
; disagree, the JSON Schema is authoritative.

start = ard-manifest

; --- The Manifest ---
; ARD requires only an `entries` array. Any other top-level member is
; transport-defined and ignored by ARD, hence the trailing wildcard.

ard-manifest = {
  entries: [* ard-entry],
  * tstr => any
}

; --- The ARD entry ---
; The unit ARD is defined over. Every ARD entry is a well-formed catalog entry;
; not every catalog entry is an ARD entry.

ard-entry = {
  ard-entry-required,
  ard-entry-descriptive,
  * tstr => any   ; terms from namespaces declared in @context remain valid
}

ard-entry-required = (
  identifier: tstr, ; URN pattern: urn:air:<publisher>:<namespace>:<agent-name>
  displayName: tstr,
  type: tstr,       ; IANA Media Type (e.g. application/mcp-server-card+json)
  content-delivery  ; strict value-or-reference
)

ard-entry-descriptive = (
  ? "@context" => any,  ; string, object, or array of either
  ? "@id" => tstr,
  ? description: tstr,
  ? tags: [+ tstr],
  ? capabilities: [+ tstr],
  ? representativeQueries: [* tstr], ; RECOMMENDED; conformance tester warns if absent or count is not 2-5
  ? version: tstr,
  ? updatedAt: tstr, ; ISO 8601 timestamp
  ? metadata: {* tstr => (tstr / int / float / bool / null)},
  ? trustManifest: trust-manifest
)

content-delivery = (
  url: tstr //
  data: {* tstr => any}
)

; --- The Zero-Trust / Compliance Envelope ---
; ARD requires only `identity`. The envelope is framework-defined and open:
; a registry is expected to verify it per the framework named in trustSchema.

trust-manifest = {
  identity: tstr, ; SPIFFE, DID, or FQDN URI
  ? identityType: tstr, ; hint, e.g. "spiffe" / "did" / "https"
  ? trustSchema: trust-schema,
  ? attestations: [* attestation],
  ? provenance: [* provenance-link],
  ? signature: tstr,
  * tstr => any
}

trust-schema = {
  ? identifier: tstr,
  ? version: tstr,
  ? governanceUri: tstr,
  ? verificationMethods: [* tstr],
  * tstr => any
}

attestation = {
  type: tstr,
  uri: tstr,
  ? mediaType: tstr,
  ? digest: tstr,
  * tstr => any
}

provenance-link = {
  relation: tstr, ; e.g. "derivedFrom" / "publishedFrom" / "copiedFrom"
  sourceId: tstr,
  ? sourceDigest: tstr,
  * tstr => any
}

; --- The Search and Explore Registry API Payloads ---

query-model = {
  ? text: tstr,
  ? filter: {* tstr => ([+ tstr] / tstr)}
}

search-query-model = {
  text: tstr,
  ? "@context" => any,
  ? filter: {* tstr => ([+ tstr] / tstr)}
}

search-request = {
  query: search-query-model,
  ? federation: "auto" / "referrals" / "none",
  ? pageSize: uint,
  ? pageToken: tstr
}

explore-request = {
  ? query: query-model,
  resultType: {
    facets: [+ explore-facet-request]
  }
}

explore-facet-request = {
  field: tstr,
  ? limit: uint,
  ? minCount: uint
}

explore-response = {
  resultType: "facets",
  facets: {* tstr => explore-facet-result}
}

explore-facet-result = {
  buckets: [* explore-facet-bucket],
  ? otherCount: uint
}

explore-facet-bucket = {
  value: tstr,
  count: uint
}

search-response = {
  results: [* search-result-item],
  ? referrals: [* registry-referral],
  ? pageToken: tstr
}

search-result-item = {
  result-entry-fields,
  score: 0..100, ; Semantic relevance score
  source: tstr,  ; Registry base URL
  * tstr => any
}

result-entry = { result-entry-fields, * tstr => any }

result-entry-fields = (
  identifier: tstr,
  ? displayName: tstr,
  ? type: tstr,
  ? url: tstr,
  ? data: {* tstr => any},
  ard-entry-descriptive
)

registry-referral = {
  identifier: tstr,
  displayName: tstr,
  type: "application/ai-registry" / "application/ai-registry+json",
  url: tstr
}

; In search and list results a registry returns the terms useful for selecting
; among results and MAY omit any other; only `identifier` is required.

list-response = {
  items: [* result-entry],
  ? total: uint,
  ? pageToken: tstr
}

error-response = {
  errorCode: tstr,
  message: tstr
}

; --- The Change Feed (GET /changes) ---
; A change carries an identifier and nothing about the entry; a consumer
; fetches the entry from the identifier's authority and confirms deletes there.

cursor = tstr .regexp "[-A-Za-z0-9._~]{1,256}" ; opaque; compared for equality only

change = {
  cursor: cursor,          ; later than every earlier change in the same registry
  op: "upsert" / "delete", ; a consumer skips an op it does not recognize and still advances
  time: tstr,              ; ISO 8601 timestamp from the producer's clock; informational
  identifier: tstr         ; URN pattern: urn:air:<publisher>:[<namespace>:]<agent-name>
}

changes-response = {
  changes: [*1000 change], ; oldest to newest; MAY be empty
  cursor: cursor,          ; present even when changes is empty
  more: bool,
  ? retention: tstr        ; ISO 8601 duration; absent when retention is unbounded
}

; Helper generic value type
any = any-cbor / any-json
any-cbor = bool / int / float / tstr / bstr / [* any-cbor] / {* any-cbor => any-cbor}
any-json = bool / int / float / tstr / null / [* any-json] / {* tstr => any-json}
null = nil
